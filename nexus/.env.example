# NEXUS — configurazione locale. Copia in `nexus/.env` e modifica se serve.
# Nessuna variabile è obbligatoria: i valori predefiniti funzionano offline e gratis.

NEXUS_ENV=development
# SQLite (predefinito). PostgreSQL: installa psycopg e imposta ad es.
# NEXUS_DATABASE_URL=postgresql+psycopg://utente:password@localhost:5432/nexus
NEXUS_AUTO_MIGRATE=true
NEXUS_LOG_LEVEL=INFO
# Cartella dei dati locali (database, file importati, cache, chiave di cifratura).
# NEXUS_DATA_DIR=/percorso/assoluto/data

# --- Autenticazione -----------------------------------------------------------
# local = uso personale, utente unico (server solo su 127.0.0.1)
# multi = account con registrazione e login (SaaS). Il primo account registrato è admin.
NEXUS_AUTH_MODE=local
NEXUS_ALLOW_REGISTRATION=true
NEXUS_SESSION_HOURS=168
# true in produzione dietro HTTPS
NEXUS_COOKIE_SECURE=false

# --- Sicurezza ------------------------------------------------------------------
# Chiave per cifrare le credenziali salvate. Se assente viene generata in data/secret.key.
# NEXUS_SECRET_KEY=una-frase-lunga-e-casuale

# --- Fonti dati -----------------------------------------------------------------
NEXUS_CONNECTOR_TIMEOUT=6
NEXUS_CONNECTOR_CACHE_HOURS=24
NEXUS_MAX_UPLOAD_MB=25

# --- Ricerca semantica ------------------------------------------------------------
# lsa (predefinito, scikit-learn) oppure sentence-transformers (pip install -r backend/requirements-ml.txt)
NEXUS_EMBEDDINGS=lsa
# NEXUS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- AI ---------------------------------------------------------------------------
# Provider predefinito se l'utente non ne sceglie uno: none = modalità locale.
# Le credenziali dei provider si configurano dall'interfaccia (Sistema → Credenziali).
NEXUS_AI_PROVIDER=none
# Numero massimo di passi automatici per ricerca multi-agente.
NEXUS_MAX_AGENT_STEPS=12
