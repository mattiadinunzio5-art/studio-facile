# NEXUS — configurazione locale. Copia in `nexus/.env` e modifica se serve.
# Nessuna variabile è obbligatoria: i valori predefiniti funzionano offline.

NEXUS_ENV=development
# SQLite (predefinito). Per PostgreSQL in futuro:
# NEXUS_DATABASE_URL=postgresql+psycopg://utente:password@localhost:5432/nexus
# NEXUS_DATABASE_URL=sqlite:////percorso/assoluto/nexus.db
NEXUS_AUTO_MIGRATE=true
NEXUS_LOG_LEVEL=INFO
NEXUS_CONNECTOR_TIMEOUT=6
# Provider AI: "none" = modalità locale. Nessun provider esterno è attivo in Fase 1.
NEXUS_AI_PROVIDER=none
